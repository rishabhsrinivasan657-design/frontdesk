# Front Desk production env (M10). Copy to /opt/frontdesk/.env.production on the VM, fill it in
# there, then `chmod 600` it. Never commit the filled file, paste it anywhere, or print it.
# docs/deploy.md walks through every value.

# --- Site ---
# Your DuckDNS name, e.g. casa-fiorella.duckdns.org (no https://).
SITE_HOST=casa-fiorella.duckdns.org
# Browser origins allowed to open a chat socket: https://<SITE_HOST>.
WEB_ORIGINS=https://casa-fiorella.duckdns.org
# Where /privacy tells people to send deletion requests (optional).
NEXT_PUBLIC_PRIVACY_CONTACT=

# --- Database (only reachable inside the Docker network) ---
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- LLM: free tier only. The api refuses to start otherwise. ---
LLM_PROVIDER=gemini
LLM_TIER=free
SPEND_CAP_USD_MONTHLY=0
LLM_RECORD=0
# From Google AI Studio, for a project with NO billing account linked.
GEMINI_API_KEY=

# --- Google Calendar + Gmail (demo account, docs/google-setup.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Owner dashboard login: make the hash with `pnpm owner:hash` (keep the single quotes) ---
OWNER_EMAIL=
OWNER_PASSWORD_HASH='$2b$12$change-me'

# --- Abuse protection ---
# Cloudflare Turnstile widget for SITE_HOST (docs/deploy.md). The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=casa-fiorella.duckdns.org
# Keys the hashes in rate-limit keys. Make one with: openssl rand -hex 32
KEY_HASH_SECRET=change-me
