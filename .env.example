# Host ports are deliberately non-standard so Front Desk never collides with a
# locally installed Postgres/Redis. Change them here (and in the URLs) if needed.
POSTGRES_PORT=54320
REDIS_PORT=63790
DATABASE_URL=postgres://frontdesk:frontdesk@localhost:54320/frontdesk
EVAL_DATABASE_URL=postgres://frontdesk:frontdesk@localhost:54320/frontdesk_eval
REDIS_URL=redis://localhost:63790
# pnpm db:migrate applies migrations to both databases above. The worker
# (pnpm --filter @frontdesk/worker start) uses DATABASE_URL and REDIS_URL.

# LLM layer (spec §7). Put GEMINI_API_KEY in your git-ignored .env; never commit it.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIER=free
SPEND_CAP_USD_MONTHLY=0
LLM_RECORD=0
# Per-call Gemini timeout in ms (default 10000; pnpm eval uses 30000).
LLM_TIMEOUT_MS=
GEMINI_API_KEY=

# Google Calendar + Gmail (M5). Follow docs/google-setup.md. Put the client id and
# secret in your git-ignored .env; `pnpm google:auth` writes the refresh token there.
# Never commit these or paste them anywhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The "Casa Fiorella (demo)" calendar's id (…@group.calendar.google.com), never "primary".
GOOGLE_CALENDAR_ID=
# Your own address: the live Gmail test sends one confirmation email here.
GMAIL_TEST_TO=
